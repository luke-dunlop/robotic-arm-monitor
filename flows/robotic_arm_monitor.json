    {
        "id": "6e54e6542ba185bd",
        "type": "function",
        "z": "8623a164f47cd65a",
        "name": "process telemetry",
        "func": "const temperature = msg.payload.temperature;\nconst current = msg.payload.current;\nconst vibration = msg.payload.vibration;\n\nlet status = \"NORMAL\";\nlet alarms = [];\n\nif (context.get(\"startTime\") === undefined) {\n    context.set(\"startTime\", Date.now());\n}\n\nconst startTime = context.get(\"startTime\");\nconst elapsedSeconds = (Date.now() - startTime) / 1000;\n\nmsg.payload.time = elapsedSeconds;\n\nif (temperature > 65) {\n    alarms.push(\"HIGH TEMPERATURE\");\n}\n\nif (current > 9) {\n    alarms.push(\"OVERCURRENT\");\n}\n\nif (vibration > 1.2) {\n    alarms.push(\"HIGH VIBRATION\");\n}\n\nif (alarms.length > 0) {\n    status = \"WARNING\";\n}\n\nmsg.payload.status = status;\nmsg.payload.alarms = alarms;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
